{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logofitrack.png",
    "scheme": "fittrack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/fittracksplash.png",
      "resizeMode": "cover",
      "backgroundColor": "#120600"
    },
    "ios": {
      "bundleIdentifier": "com.seupersonaltrack.fittrack",
      "supportsTablet": true
    },
    "android": {
      "package": "com.seupersonaltrack.fittrack",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/loginhofittrack.png",
        "backgroundColor": "#120600"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59cf295d-6833-4285-9b49-cc4a9e120c25"
      }
    }
  }
}
